+int ext_mkdir(ext_context_t* ctx, const char* path) {
+  if (!ctx || !ctx->valid || !path || !path[0]) return -1;
+
+  int plen = 0, last_slash = -1;
+  while (path[plen]) { if (path[plen] == '/') last_slash = plen; plen++; }
+  const char* leaf = last_slash >= 0 ? path + last_slash + 1 : path;
+  if (!leaf[0] || (leaf[0] == '.' && leaf[1] == 0) ||
+      (leaf[0] == '.' && leaf[1] == '.' && leaf[2] == 0)) return -1;
+
+  char parent[EXT_NAME_MAX];
+  if (last_slash >= 0) {
+    int n = last_slash;
+    if (n >= (int)sizeof(parent)) n = sizeof(parent) - 1;
+    ix_memcpy(parent, path, n); parent[n] = 0;
+  } else parent[0] = 0;
+
+  uint32_t parent_ino = EXT_ROOT_INO;
+  if (parent[0] && !ext_lookup_path(ctx, parent, &parent_ino)) return -1;
+  ext_inode_t pino;
+  if (!ext_read_inode(ctx, parent_ino, &pino)) return -1;
+  if ((erd16((const uint8_t*)&pino.i_mode) & 0xF000u) != 0x4000u) return -1;
+  if (ext_lookup_in_dir(ctx, parent_ino, leaf)) return -1;
+
+  uint32_t child = ext_ialloc(ctx);
+  if (!child) return -1;
+
+  ext_inode_t ci;
+  ix_memset(&ci, 0, sizeof(ci));
+  ewr16((uint8_t*)&ci.i_mode, 0x41EDu); /* directory 0755 */
+  ewr16((uint8_t*)&ci.i_uid, 0);
+  ewr16((uint8_t*)&ci.i_gid, 0);
+  ewr16((uint8_t*)&ci.i_links_count, 2);
+  ewr32((uint8_t*)&ci.i_size, ctx->block_size);
+
+  uint32_t phys;
+  if (ctx->has_extents) {
+    phys = ext_extent_append_block(ctx, &ci, 0);
+  } else {
+    phys = ext_ensure_indirect(ctx, &ci, 0);
+  }
+  if (!phys) return -1;
+
+  static uint8_t zeros[EXT_SECBUF_SIZE];
+  if (ctx->block_size > sizeof(zeros) || !ext_write_block(ctx, phys, zeros)) return -1;
+
+  /* ext directory block: '.' followed by '..', occupying the whole block. */
+  ix_memset(g_ext_dirbuf, 0, ctx->block_size);
+  ewr32(g_ext_dirbuf + 0, child);
+  ewr16(g_ext_dirbuf + 4, 12);
+  g_ext_dirbuf[6] = 1; g_ext_dirbuf[7] = EXT_FT_DIR; g_ext_dirbuf[8] = '.';
+  ewr32(g_ext_dirbuf + 12, parent_ino);
+  ewr16(g_ext_dirbuf + 16, (uint16_t)(ctx->block_size - 12));
+  g_ext_dirbuf[18] = 2; g_ext_dirbuf[19] = EXT_FT_DIR;
+  g_ext_dirbuf[20] = '.'; g_ext_dirbuf[21] = '.';
+  if (!ext_write_block(ctx, phys, g_ext_dirbuf)) return -1;
+  if (!ext_write_inode(ctx, child, &ci)) return -1;
+
+  if (ext_add_dir_entry(ctx, parent_ino, leaf, child, EXT_FT_DIR) != 0) return -1;
+  /* A child directory adds one link to its parent. */
+  if (ext_read_inode(ctx, parent_ino, &pino)) {
+    uint16_t links = erd16((const uint8_t*)&pino.i_links_count);
+    ewr16((uint8_t*)&pino.i_links_count, (uint16_t)(links + 1));
+    if (!ext_write_inode(ctx, parent_ino, &pino)) return -1;
+  }
+  return 0;
+}
