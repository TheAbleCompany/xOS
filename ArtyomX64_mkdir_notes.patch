diff --git a/lib/syscalls.c b/lib/syscalls.c
index b3cc861..3af38f7 100644
--- a/lib/syscalls.c
+++ b/lib/syscalls.c
@@ -14,6 +14,7 @@
 #include "../fs/fs.h"
 #include "../multitask/elf.h"
 #include "../fs/initrd.h"
+#include "../fs/ix/ix_automount.h"
 #include "../multitask/task.h"
 #include "../fs/file.h"
 
@@ -429,6 +430,33 @@ int lseek(
 
 
 
+/*
+ * ============================================================
+ * mkdir -- syscall 83 (Linux-compatible number)
+ * ============================================================
+ * Bare paths and initrd/... target the writable RAM initrd;
+ * diskN/... targets writable FAT12/16/32 or EXT volumes. EXT/NTFS currently
+ * remain read-only and report failure instead of pretending success.
+ */
+int mkdir(const char *path, unsigned int mode)
+{
+    (void)mode;
+    if (!path || !path[0]) return -1;
+    const char *name = skip_leading_slashes(path);
+    if (!name || !name[0]) return -1;
+    for (int i = 0; i < automount_count(); i++) {
+        const char *disk_name = automount_disk_name(i);
+        if (!disk_name) continue;
+        int n = 0; while (disk_name[n]) n++;
+        if (strncmp(name, disk_name, n) == 0 && name[n] == '/')
+            return automount_mkdir_at(i, name + n + 1);
+        if (strncmp(name, disk_name, n) == 0 && name[n] == 0) return -1;
+    }
+    if (strncmp(name, "initrd/", 7) == 0) name += 7;
+    else if (strcmp(name, "initrd") == 0) return -1;
+    return initrd_mkdir(name);
+}
+
 /*
  * ============================================================
  * unlink
@@ -577,6 +605,11 @@ void syscall_handler(
             break;
 
 
+        /* mkdir (Linux x86 syscall number 83) */
+        case 83:
+            regs->rax = (uint64_t)(int64_t)mkdir((const char *)regs->rdi, (unsigned int)regs->rsi);
+            break;
+
         /*
          * open
          */
diff --git a/lib/unistd.h b/lib/unistd.h
index d0d294a..2cee273 100644
--- a/lib/unistd.h
+++ b/lib/unistd.h
@@ -194,3 +194,15 @@ int compat_exec(const void *path){
 }
 
 #endif /* AX_UNISTD_H */
+
+/* Create a directory: syscall 83. Returns 0 on success, -1 on failure. */
+int mkdir(const char *path, unsigned int mode) {
+    int ret;
+    __asm__ volatile(
+        "int $0x80"
+        : "=a"(ret)
+        : "a"(83), "D"((long)path), "S"((long)mode)
+        : "memory"
+    );
+    return ret;
+}
