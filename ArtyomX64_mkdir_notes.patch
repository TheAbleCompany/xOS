+int automount_mkdir_at(int idx, const char *relpath) {
+    if (idx < 0 || idx >= g_am_n || !relpath || !relpath[0]) return -1;
+    am_mount_t *m = &g_am[idx];
+    if (m->read_only || m->fs_type == IX_FS_TYPE_NTFS) return -1;
+    am_select(m);
+    char rel[AM_PATH_MAX];
+    strncpy(rel, relpath, sizeof(rel) - 1);
+    rel[sizeof(rel) - 1] = 0;
+    if (!rel[0]) return -1;
+    am_cursor_drop();
+    int rc;
+    switch (m->fs_type) {
+        case IX_FS_TYPE_FAT12:
+        case IX_FS_TYPE_FAT16:
+        case IX_FS_TYPE_FAT32:
+            rc = fat_mkdir(&m->fat, rel);
+            break;
+        case IX_FS_TYPE_EXT:
+            rc = ext_mkdir(&m->ext, rel);
+            break;
+        default:
+            return -1;
+    }
+    if (rc == 0) {
+        ixk_storage_sync();
+        /* New entries must be discovered from disk again. */
+        am_cursor_drop();
+    }
+    return rc;
+}
