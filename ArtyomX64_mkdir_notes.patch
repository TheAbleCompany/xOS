diff --git a/apps/files.c b/apps/files.c
index 41672df..4240195 100644
--- a/apps/files.c
+++ b/apps/files.c
@@ -42,6 +42,9 @@ static int last_sel = -1;
 static int last_buttons;
 
 static char status[48] = "Loading...";
+static int new_folder_mode = 0;
+static char new_folder_name[64];
+static int new_folder_len = 0;
 
 /*
  * Текущий каталог: "initrd" (образ, встроенный в ядро),
@@ -115,16 +118,26 @@ static char current_root[192] = "disk0"; /* TEMP-TEST */
  * The app's OWN menu bar
  * ============================================================ */
 
-static const char *files_file_items[] = { "Refresh", "Close Window" };
+static const char *files_file_items[] = {
+    "Open", "New Folder...", "Refresh", "Enclosing Folder", "Close Window"
+};
+static const char *files_view_items[] = {
+    "Scroll to Top", "Scroll to Bottom", "Refresh"
+};
+static const char *files_go_items[] = {
+    "Computer", "initrd", "disk0", "Enclosing Folder"
+};
 
 static const ax_menu_def_t files_menus[] = {
-    { "File", files_file_items, 2 },
+    { "File", files_file_items, 5 },
+    { "View", files_view_items, 3 },
+    { "Go", files_go_items, 4 },
 };
 
 static const ax_menubar_def_t files_menubar = {
-    "Files",
+    "Finder",
     files_menus,
-    1
+    3
 };
 
 
@@ -644,6 +657,15 @@ void render(void)
         cnt[q] = 0;
         aq_text(cnt, CW - 8 - q * 8, CH - 14, AQ_TEXT_SECOND);
     }
+    if (new_folder_mode) {
+        int fw = CW - 190;
+        int fx = (CW - fw) / 2;
+        int fy = CH / 2 - 18;
+        aq_panel(fx - 12, fy - 28, fw + 24, 78);
+        aq_text_bold("New Folder", fx, fy - 17, AQ_TEXT);
+        aq_field(fx, fy, fw, 24, new_folder_name, new_folder_len, 1);
+        aq_text("Enter = create    Esc = cancel", fx, fy + 30, AQ_TEXT_SECOND);
+    }
 }
 
 
@@ -778,20 +800,90 @@ void _start(void)
             if (ev.type == AX_EV_QUIT)
                 return;
 
-            /* Собственное меню приложения. */
-            if (ev.type == AX_EV_MENU && ev.key == 0) {
-                switch (ev.w) {
-                    case 0:         /* File > Refresh */
-                        reload_directory();
-                        last_sel = -1;
-                        render();
-                        ax_commit(g_canvas);
-                        break;
-
-                    case 1:         /* File > Close Window */
-                        ax_win_close(g_canvas);
-                        return;
+            /* Глобальное меню Finder-подобной оболочки. */
+            if (ev.type == AX_EV_MENU) {
+                int changed = 0;
+                if (ev.key == 0) { /* File */
+                    switch (ev.w) {
+                        case 0: open_selected(); changed = 1; break;
+                        case 1:
+                            new_folder_mode = 1;
+                            new_folder_len = 0;
+                            new_folder_name[0] = 0;
+                            set_status("Enter folder name");
+                            changed = 1;
+                            break;
+                        case 2: reload_directory(); last_sel = -1; changed = 1; break;
+                        case 3:
+                            if (go_up()) {
+                                sel = last_sel = -1; scroll_row = 0;
+                                reload_directory();
+                            } else set_status("Already at volume root");
+                            changed = 1; break;
+                        case 4: ax_win_close(g_canvas); return;
+                    }
+                } else if (ev.key == 1) { /* View */
+                    switch (ev.w) {
+                        case 0: scroll_row = 0; changed = 1; break;
+                        case 1: scroll_row = max_scroll_row(); changed = 1; break;
+                        case 2: reload_directory(); changed = 1; break;
+                    }
+                } else if (ev.key == 2) { /* Go */
+                    switch (ev.w) {
+                        case 0: /* Computer: default volume root */
+                            copy_text(current_root, "disk0", sizeof(current_root));
+                            break;
+                        case 1:
+                            copy_text(current_root, "initrd", sizeof(current_root));
+                            break;
+                        case 2:
+                            copy_text(current_root, "disk0", sizeof(current_root));
+                            break;
+                        case 3:
+                            if (!go_up()) set_status("Already at volume root");
+                            break;
+                    }
+                    sel = last_sel = -1;
+                    scroll_row = 0;
+                    reload_directory();
+                    changed = 1;
+                }
+                if (changed) {
+                    clamp_scroll();
+                    render();
+                    ax_commit(g_canvas);
+                }
+                continue;
+            }
+
+            if (ev.type == AX_EV_KEY && new_folder_mode) {
+                if (ev.key == 27) {
+                    new_folder_mode = 0;
+                    set_status("Cancelled");
+                } else if (ev.key == AX_KEY_ENTER || ev.key == '\n' || ev.key == '\r') {
+                    new_folder_mode = 0;
+                    if (new_folder_len == 0) {
+                        set_status("Folder name is empty");
+                    } else {
+                        char path[256];
+                        make_path(path, sizeof(path), current_root, new_folder_name);
+                        if (mkdir(path, 0) == 0) {
+                            set_status("Folder created");
+                            sel = last_sel = -1;
+                            scroll_row = 0;
+                            reload_directory();
+                        } else {
+                            set_status("Cannot create folder (read-only?)");
+                        }
+                    }
+                } else if (ev.key == AX_KEY_BACKSPACE || ev.key == '\b') {
+                    if (new_folder_len > 0) new_folder_name[--new_folder_len] = 0;
+                } else if (ev.key >= 32 && ev.key < 127 && new_folder_len < (int)sizeof(new_folder_name) - 1) {
+                    new_folder_name[new_folder_len++] = (char)ev.key;
+                    new_folder_name[new_folder_len] = 0;
                 }
+                render();
+                ax_commit(g_canvas);
                 continue;
             }
 
