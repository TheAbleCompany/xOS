+/* Create a RAM-backed directory entry. Paths are relative to initrd root. */
+int initrd_mkdir(const char *path)
+{
+    if (!path || !path[0]) return -1;
+    while (*path == '/') path++;
+    int len = 0;
+    while (path[len]) {
+        if (path[len] == '\\') return -1;
+        len++;
+    }
+    if (len == 0 || len >= 127 || path[len - 1] == '/') return -1;
+    for (int i = 0; i < len; i++) if ((unsigned char)path[i] < 32) return -1;
+    if (!strcmp(path, ".") || !strcmp(path, "..")) return -1;
+
+    /* Parent must already exist; nested creation is supported incrementally. */
+    char parent[128];
+    int slash = -1;
+    for (int i = 0; i < len; i++) if (path[i] == '/') slash = i;
+    if (slash >= 0) {
+        if (slash == 0) return -1;
+        for (int i = 0; i < slash; i++) parent[i] = path[i];
+        parent[slash] = 0;
+        char full_parent[140];
+        strcpy(full_parent, "initrd/");
+        int fp = 7; while (parent[fp - 7] && fp < (int)sizeof(full_parent) - 1) { full_parent[fp] = parent[fp - 7]; fp++; } full_parent[fp] = 0;
+        fs_node_t *pn = resolve_path(full_parent);
+        if (!pn || (pn->flags & 0x7) != FS_DIRECTORY) return -1;
+    }
+
+    for (int i = 0; i < nroot_nodes; i++)
+        if (!strcmp(path, root_nodes[i].name)) return -1;
+
+    if (nroot_nodes >= root_nodes_cap) {
+        int ncap = root_nodes_cap ? root_nodes_cap * 2 : 16;
+        fs_node_t *nn = (fs_node_t *)malloc(sizeof(fs_node_t) * ncap);
+        if (!nn) return -1;
+        if (root_nodes) { memcpy(nn, root_nodes, sizeof(fs_node_t) * nroot_nodes); free(root_nodes); }
+        root_nodes = nn; root_nodes_cap = ncap;
+    }
+    fs_node_t *node = &root_nodes[nroot_nodes++];
+    memset(node, 0, sizeof(*node));
+    strcpy(node->name, path);
+    node->flags = FS_DIRECTORY;
+    node->impl = FS_IMPL_INITRD;
+    node->readdir = &initrd_readdir;
+    node->finddir = &initrd_finddir;
+    debug_puts("INITRD: created directory: "); debug_puts(path); debug_putc('\n');
+    return 0;
+}
