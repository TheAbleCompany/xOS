+/* Create a FAT directory using the existing long-name entry writer. */
+int fat_mkdir(fat_context_t* ctx, const char* path) {
+  if (!ctx || !ctx->valid || !path || !path[0]) return -1;
+  int plen = 0, last_slash = -1;
+  while (path[plen]) { if (path[plen] == '/' || path[plen] == '\\') last_slash = plen; plen++; }
+  const char* leaf = last_slash >= 0 ? path + last_slash + 1 : path;
+  if (!leaf[0] || (leaf[0] == '.' && leaf[1] == 0) || (leaf[0] == '.' && leaf[1] == '.' && leaf[2] == 0)) return -1;
+
+  fat_lookup_result_t exists;
+  if (fat_lookup_path(ctx, path, &exists) && exists.found) return -1;
+
+  /* Allocate and initialise the directory's first cluster before publishing it. */
+  uint32_t new_cluster = fat_alloc_cluster(ctx);
+  if (new_cluster < 2u || !fat_zero_cluster(ctx, new_cluster)) {
+    if (new_cluster >= 2u) fat_set_fat_entry(ctx, new_cluster, 0);
+    return -1;
+  }
+
+  if (fat_create(ctx, path) != 0) {
+    fat_set_fat_entry(ctx, new_cluster, 0);
+    fat_alloc_cache_invalidate();
+    return -1;
+  }
+
+  char parent[FAT_NAME_MAX];
+  if (last_slash >= 0) {
+    int n = last_slash;
+    if (n >= (int)sizeof(parent)) n = sizeof(parent) - 1;
+    ix_memcpy(parent, path, n); parent[n] = 0;
+  } else parent[0] = 0;
+
+  int root16 = 0;
+  uint32_t parent_cluster = 0;
+  if (!parent[0] || (parent[0] == '/' && !parent[1])) {
+    if (ctx->fat_type == IX_FS_TYPE_FAT32) parent_cluster = ctx->root_cluster;
+    else root16 = 1;
+  } else {
+    fat_lookup_result_t pr;
+    if (!fat_lookup_path(ctx, parent, &pr) || !pr.found || !(pr.attr & FAT_ATTR_DIRECTORY)) {
+      fat_set_fat_entry(ctx, new_cluster, 0); return -1;
+    }
+    parent_cluster = pr.cluster;
+  }
+
+  uint64_t ent_lba = 0; uint32_t ent_idx = 0;
+  fat_lookup_result_t lr;
+  int scanned = root16 ? fat_scan_dir_root16(ctx, leaf, &lr, &ent_lba, &ent_idx)
+                       : fat_scan_dir_cluster(ctx, parent_cluster, leaf, &lr, &ent_lba, &ent_idx);
+  if (!scanned || !lr.found || !fat_read_sector(ctx, ent_lba, 1, g_fat_secbuf)) {
+    fat_set_fat_entry(ctx, new_cluster, 0); return -1;
+  }
+  fat_dir_entry_t* de = (fat_dir_entry_t*)(g_fat_secbuf + ent_idx * 32u);
+  de->attr = FAT_ATTR_DIRECTORY;
+  de->fst_clus_lo = (uint16_t)(new_cluster & 0xFFFFu);
+  de->fst_clus_hi = (uint16_t)((new_cluster >> 16) & 0xFFFFu);
+  de->file_size = 0;
+  if (!fat_write_sector(ctx, ent_lba, 1, g_fat_secbuf)) {
+    fat_set_fat_entry(ctx, new_cluster, 0); return -1;
+  }
+
+  /* FAT requires '.' and '..' entries in a directory cluster. */
+  ix_memset(g_fat_secbuf, 0, ctx->bytes_per_sector);
+  fat_dir_entry_t* dot = (fat_dir_entry_t*)g_fat_secbuf;
+  ix_memset(dot->name, ' ', 11); dot->name[0] = '.';
+  dot->attr = FAT_ATTR_DIRECTORY;
+  dot->fst_clus_lo = (uint16_t)(new_cluster & 0xFFFFu);
+  dot->fst_clus_hi = (uint16_t)(new_cluster >> 16);
+  dot++;
+  ix_memset(dot->name, ' ', 11); dot->name[0] = '.'; dot->name[1] = '.';
+  dot->attr = FAT_ATTR_DIRECTORY;
+  dot->fst_clus_lo = (uint16_t)(parent_cluster & 0xFFFFu);
+  dot->fst_clus_hi = (uint16_t)(parent_cluster >> 16);
+  if (!fat_write_sector(ctx, fat_cluster_to_lba(ctx, new_cluster), 1, g_fat_secbuf)) return -1;
+  fat_alloc_cache_invalidate();
+  return 0;
+}
